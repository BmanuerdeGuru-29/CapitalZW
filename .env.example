# CapitalZW Environment Configuration
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=change-me-to-a-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL - used in Docker/production)
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_DB=capitalzw
POSTGRES_USER=capitalzw
POSTGRES_PASSWORD=capitalzw_secret

# Email (console backend for dev)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@capitalzw.co.zw

# Security (production)
SECURE_SSL_REDIRECT=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
